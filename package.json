{
  "name": "@beihaizb/dsh-notebook",
  "version": "0.2.2",
  "description": "A stateful, Agent-controllable Jupyter workspace for DeepSeek Harness: a persistent ipykernel runtime the DSH agent can read, edit, execute, and inspect, with VS Code-aligned cell UI and .ipynb save/load.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beihzb/dsh-notebook.git"
  },
  "bugs": {
    "url": "https://github.com/beihzb/dsh-notebook/issues"
  },
  "homepage": "https://github.com/beihzb/dsh-notebook",
  "scripts": {
    "build:cm": "esbuild scripts/cm-entry.mjs --bundle --format=iife --outfile=lib/cm-vendor.js --minify"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/cm-vendor.js",
    "python/kernel_driver.py",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "jupyter",
    "notebook",
    "ipynb",
    "ipykernel",
    "agent",
    "runtime",
    "workspace",
    "data-analysis",
    "scanpy",
    "scvi"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.9"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
